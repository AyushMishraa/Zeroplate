# ZeroPlate Environment Configuration Example
# Copy this file to .env or backend/.env and populate your credentials

# Application Ports
PORT=5000
FRONTEND_URL=http://localhost:4200

# Database (Leave default for local Docker MongoDB container, or set to your MongoDB Atlas connection string)
DB_HOST=mongodb://mongodb:27017/zeroplate

# Redis (Managed automatically in Docker Compose)
REDIS_HOST=redis
REDIS_PORT=6379

# Authentication & JWT
JWT_SECRET=your_super_secret_jwt_key_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
OAUTH_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Google Maps API (For location and NGO matching distance calculations)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Email Notification Service (SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password
